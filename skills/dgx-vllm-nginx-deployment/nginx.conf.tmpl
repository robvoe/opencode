worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr info;

events {
    worker_connections 1024;
}

http {
    log_format deployment 'upstream=$upstream_addr status=$status';

    upstream vllm {
        zone vllm 64k;
        least_conn;
__UPSTREAM_SERVERS__
        keepalive 32;
    }

    server {
        listen __LB_PORT__ ssl;
        ssl_certificate     /keys/__CERT_FILENAME__;
        ssl_certificate_key /keys/__KEY_FILENAME__;

        location / {
            proxy_pass http://vllm;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_buffering off;
            proxy_cache off;
            proxy_read_timeout 600s;
            proxy_send_timeout 600s;
            access_log /dev/stdout deployment;
        }
    }
}
